function getInterfaceLanguage() {
  const language = String(getSetting_('LANGUE_INTERFACE') || 'fr').toLowerCase();
  return INTERFACE_LANGUAGES[language] ? language : 'fr';
}

function getLanguagePack(language) {
  const code = String(language || getInterfaceLanguage()).toLowerCase();
  const safeCode = INTERFACE_LANGUAGES[code] ? code : 'fr';
  return {
    code: safeCode,
    name: INTERFACE_LANGUAGES[safeCode],
    available: Object.keys(INTERFACE_LANGUAGES).map(key => ({ code: key, name: INTERFACE_LANGUAGES[key] })),
    translations: INTERFACE_TRANSLATIONS[safeCode] || {}
  };
}
