{
  "name": "coordodiscours",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-apps-script.mjs",
    "test:business": "node scripts/test-business-rules.mjs",
    "test:conflicts": "node scripts/test-conflict-resolution.mjs",
    "test:auto": "node scripts/test-automatic-planning.mjs",
    "test:availability": "node scripts/test-speaker-availability.mjs",
    "check": "npm run validate && npm run test:business && npm run test:conflicts && npm run test:auto && npm run test:availability",
    "predeploy:check": "npm run check && node scripts/predeploy-check.mjs",
    "clasp:login": "npx @google/clasp login",
    "clasp:status": "npx @google/clasp status",
    "clasp:push": "npm run predeploy:check && npx @google/clasp push",
    "clasp:deploy": "npm run predeploy:check && npx @google/clasp deploy"
  },
  "devDependencies": {
    "@google/clasp": "^3.0.0-alpha"
  }
}
